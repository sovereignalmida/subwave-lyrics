# Public origin of the SUB/WAVE station. The app derives /api and /stream.mp3.
SUBWAVE_STATION_URL=https://radio.example.com

# Optional same-network overrides. Leave blank for normal remote/public stations.
# SUBWAVE_API_URL=http://controller:7701
# SUBWAVE_STREAM_URL=http://broadcast:7702/stream.mp3
SUBWAVE_POLL_INTERVAL=2
KEEP_STATION_ACTIVE=true
VIEWER_TTL_SECONDS=45

LRCLIB_BASE_URL=https://lrclib.net
LRCLIB_NEGATIVE_CACHE_HOURS=12

# Positive values delay lyrics to compensate for radio-stream buffering.
PLAYBACK_OFFSET_SECONDS=22

DATABASE_PATH=/data/lyrics.db
APP_HOST=0.0.0.0
APP_PORT=8095
LOG_LEVEL=INFO
